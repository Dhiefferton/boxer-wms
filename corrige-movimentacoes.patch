From 233fd562c135e9cba57b9dc1152dba1c6d02f1cb Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 31 Aug 2026 18:09:49 +0000
Subject: [PATCH] Corrige GET /movimentacoes: join quebrado em tabela
 inexistente
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Causa raiz confirmada direto no Supabase de produção: o endpoint
fazia LEFT JOIN em areas_flutuante, tabela que não existe no banco
(42P01 relation does not exist). Isso derrubava a rota inteira com
500 em QUALQUER chamada, filtrada ou não - é por isso que o
histórico da NF 139685 (e tudo mais) não aparecia na tela.

- Remove os LEFT JOINs pra areas_flutuante (tabela não existe;
  'flutuante' é tipo legado sem tabela de apoio pra nome da área -
  origem_area_nome/destino_area_nome agora voltam null pra esses
  casos, em vez de quebrar a query toda)
- Junta 'picking' no mesmo LEFT JOIN de enderecos que 'vertical',
  já que ambos guardam endereco_id na mesma tabela (ver
  tarefas.js), então posições de picking agora resolvem código de
  endereço corretamente
- Historico.jsx: formatarLocal também mostra o código do endereço
  pra tipo 'picking' (antes só tratava 'vertical')

Testado com SELECT direto no Supabase reproduzindo os 2 casos
relatados (sem filtro e ?sku=99940) - ambos rodam sem erro agora.

Também apliquei uma migração separada no banco (fora deste commit,
direto via Supabase) ampliando as CHECK constraints de
movimentacoes.tipo/origem_tipo/destino_tipo pra aceitar
'conferencia', 'embarque' e 'pedido' - sem isso, os INSERTs feitos
por conferencia-erp.js e separacao-erp.js pra esses tipos estavam
falhando silenciosamente (registrarMovimentacao é best-effort e só
loga no console).
---
 wms-api/routes/movimentacoes.js       | 20 ++++++++++++++------
 wms-dashboard/src/pages/Historico.jsx |  2 +-
 2 files changed, 15 insertions(+), 7 deletions(-)

diff --git a/wms-api/routes/movimentacoes.js b/wms-api/routes/movimentacoes.js
index 51f07b6..9ffe6f2 100644
--- a/wms-api/routes/movimentacoes.js
+++ b/wms-api/routes/movimentacoes.js
@@ -33,6 +33,16 @@ router.get('/', async (req, res) => {
 
     const where = condicoes.length > 0 ? `WHERE ${condicoes.join(' AND ')}` : '';
 
+    // IMPORTANTE: a tabela `areas_flutuante` não existe no banco de
+    // produção (confirmado direto no Supabase - dá "relation
+    // areas_flutuante does not exist"). Por isso essa rota inteira
+    // quebrava com 500 em QUALQUER chamada, com ou sem filtro. O tipo
+    // 'flutuante' é legado (poucas linhas antigas) e não tem mais
+    // tabela de apoio pra resolver o nome da área - por isso
+    // origem_area_nome/destino_area_nome sempre voltam null agora.
+    // 'picking' (posições do andar 1) usa a mesma tabela `enderecos`
+    // que 'vertical' (endereco_id aponta pra lá em ambos os casos -
+    // ver tarefas.js/reposicao), então entra no mesmo LEFT JOIN.
     try {
         const { rows } = await pool.query(
             `SELECT
@@ -41,14 +51,12 @@ router.get('/', async (req, res) => {
                 p.sku, p.descricao,
                 eo.codigo AS origem_endereco_codigo,
                 ed.codigo AS destino_endereco_codigo,
-                ao.nome AS origem_area_nome,
-                ad.nome AS destino_area_nome
+                NULL::varchar AS origem_area_nome,
+                NULL::varchar AS destino_area_nome
              FROM movimentacoes m
              JOIN produtos p ON p.id = m.produto_id
-             LEFT JOIN enderecos eo ON m.origem_tipo = 'vertical' AND eo.id = m.origem_id
-             LEFT JOIN enderecos ed ON m.destino_tipo = 'vertical' AND ed.id = m.destino_id
-             LEFT JOIN areas_flutuante ao ON m.origem_tipo = 'flutuante' AND ao.id = m.origem_id
-             LEFT JOIN areas_flutuante ad ON m.destino_tipo = 'flutuante' AND ad.id = m.destino_id
+             LEFT JOIN enderecos eo ON m.origem_tipo IN ('vertical', 'picking') AND eo.id = m.origem_id
+             LEFT JOIN enderecos ed ON m.destino_tipo IN ('vertical', 'picking') AND ed.id = m.destino_id
              ${where}
              ORDER BY m.criado_em DESC
              LIMIT $${valores.length + 1} OFFSET $${valores.length + 2}`,
diff --git a/wms-dashboard/src/pages/Historico.jsx b/wms-dashboard/src/pages/Historico.jsx
index 8d64f86..c2e50c1 100644
--- a/wms-dashboard/src/pages/Historico.jsx
+++ b/wms-dashboard/src/pages/Historico.jsx
@@ -23,7 +23,7 @@ ajuste_manual: 'var(--muted)',
 };
 
 function formatarLocal(tipo, enderecoCodigo, areaNome) {
-if (tipo === 'vertical') return enderecoCodigo || '—';
+if (tipo === 'vertical' || tipo === 'picking') return enderecoCodigo || '—';
 if (tipo === 'flutuante') return areaNome || '—';
 if (tipo === 'externo') return 'Externo';
 if (tipo === 'pedido') return 'Pedido (separação)';
