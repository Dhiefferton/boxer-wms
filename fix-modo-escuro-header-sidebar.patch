From 3302adba21aae7111a2a97f070e7a67afc5f212b Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 2 Sep 2026 19:35:46 +0000
Subject: [PATCH] fix: ajustes visuais do modo escuro (dash) - header de tabela
 e sidebar

1. Header da tabela de Produtos ficava branco no modo escuro: usava
   'var(--card-bg, #fff)', uma variavel que nunca existiu (o nome
   certo e --bg-card) - sempre caia no fallback #fff. Corrigido pra
   var(--bg-card).

2. Sidebar continuava no navy vibrante do tema claro mesmo no
   escuro, destoando do resto da tela (que fica bem mais escura).
   Nova variavel --sidebar-bg: no claro continua = --boxer-navy
   (sem mudanca visual nenhuma la), no escuro passa a ser um tom de
   superficie (#161a26) que combina com os cards/paineis do resto
   da tela.

So mexe no modo escuro - claro fica exatamente como estava.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_011F5EkFD7qzPQU95aiex7Ei
---
 wms-dashboard/src/components/Sidebar.jsx |  2 +-
 wms-dashboard/src/pages/Produtos.jsx     |  2 +-
 wms-dashboard/src/styles/global.css      | 12 ++++++++++++
 3 files changed, 14 insertions(+), 2 deletions(-)

diff --git a/wms-dashboard/src/components/Sidebar.jsx b/wms-dashboard/src/components/Sidebar.jsx
index cf9dcdf..d7eaff8 100644
--- a/wms-dashboard/src/components/Sidebar.jsx
+++ b/wms-dashboard/src/components/Sidebar.jsx
@@ -125,7 +125,7 @@ export default function Sidebar() {
         <aside
             style={{
                 width: recolhida ? 64 : 240,
-                background: 'var(--boxer-navy)',
+                background: 'var(--sidebar-bg)',
                 color: '#fff',
                 minHeight: '100vh',
                 padding: '1.25rem 0.75rem',
diff --git a/wms-dashboard/src/pages/Produtos.jsx b/wms-dashboard/src/pages/Produtos.jsx
index 090402f..6d0e9af 100644
--- a/wms-dashboard/src/pages/Produtos.jsx
+++ b/wms-dashboard/src/pages/Produtos.jsx
@@ -322,7 +322,7 @@ export default function Produtos() {
                         <div style={{ maxHeight: 520, overflowY: 'auto' }}>
                             <table style={{ width: '100%', borderCollapse: 'collapse', fontSize: 13 }}>
                                 <thead>
-                                    <tr style={{ borderBottom: '1px solid var(--border)', position: 'sticky', top: 0, background: 'var(--card-bg, #fff)' }}>
+                                    <tr style={{ borderBottom: '1px solid var(--border)', position: 'sticky', top: 0, background: 'var(--bg-card)' }}>
                                         <th style={{ padding: 10, width: 32 }}>
                                             <input
                                                 type="checkbox"
diff --git a/wms-dashboard/src/styles/global.css b/wms-dashboard/src/styles/global.css
index c117d8f..65f8fb3 100644
--- a/wms-dashboard/src/styles/global.css
+++ b/wms-dashboard/src/styles/global.css
@@ -21,6 +21,13 @@
     --accent-bg: #e8ecfd;
     --accent-text: var(--boxer-vibrante);
 
+    /* Cor de fundo da sidebar - navy fixo no claro (decisao de
+       design anterior). No escuro, ela troca sozinha (ver bloco
+       [data-theme="escuro"] abaixo) pra combinar com o resto da
+       tela em vez de destoar como um bloco azul vibrante sobre um
+       fundo quase preto. */
+    --sidebar-bg: var(--boxer-navy);
+
     --radius: 10px;
     --font-sans: 'Inter', sans-serif;
     --font-display: 'Sora', 'Inter', sans-serif;
@@ -51,6 +58,11 @@
     --accent-text: #6b86f8;
 
     --boxer-vibrante: #4f6ef7;
+
+    /* Sidebar deixa de ser o navy vibrante do tema claro e passa a
+       usar o mesmo tom de superficie dos cards - fica discreta,
+       igual ao resto da tela, em vez de destoar. */
+    --sidebar-bg: #161a26;
 }
 
 * { box-sizing: border-box; }
-- 
2.43.0

