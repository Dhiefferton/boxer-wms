From 84c9511a088f9a736e27c2b2ae05fdc1021b6ac0 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 27 Sep 2026 22:00:52 +0000
Subject: [PATCH] fix: tag de transportadora volta pra linha do topo, agora do
 lado direito
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Ajuste do 0083 tinha invertido o pedido - o usuário queria a tag na
parte de cima do card, do lado direito (oposto ao número/data), não
embaixo à esquerda. A linha do topo virou space-between (largura
100%): número/data continuam à esquerda, tag da transportadora agora
sempre à direita, na mesma linha.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_011F5EkFD7qzPQU95aiex7Ei
---
 wms-coletor/src/pages/ConferenciaErp.jsx | 16 +++++++++-------
 wms-coletor/src/pages/SeparacaoErp.jsx   | 16 +++++++++-------
 2 files changed, 18 insertions(+), 14 deletions(-)

diff --git a/wms-coletor/src/pages/ConferenciaErp.jsx b/wms-coletor/src/pages/ConferenciaErp.jsx
index fab073f..927beaa 100644
--- a/wms-coletor/src/pages/ConferenciaErp.jsx
+++ b/wms-coletor/src/pages/ConferenciaErp.jsx
@@ -195,15 +195,17 @@ export default function ConferenciaErp() {
                         onClick={() => abrirPedido(p)}
                         style={{ display: 'flex', flexDirection: 'column', alignItems: 'flex-start', gap: 2 }}
                     >
-                        <span style={{ display: 'flex', alignItems: 'baseline', gap: 8 }}>
-                            <span style={{ fontWeight: 600 }}>{p.numero_erp}</span>
-                            {formatarData(p.criado_em) && (
-                                <span style={{ fontSize: 11, color: 'var(--text-muted)' }}>{formatarData(p.criado_em)}</span>
+                        <span style={{ display: 'flex', alignItems: 'baseline', justifyContent: 'space-between', width: '100%' }}>
+                            <span style={{ display: 'flex', alignItems: 'baseline', gap: 8 }}>
+                                <span style={{ fontWeight: 600 }}>{p.numero_erp}</span>
+                                {formatarData(p.criado_em) && (
+                                    <span style={{ fontSize: 11, color: 'var(--text-muted)' }}>{formatarData(p.criado_em)}</span>
+                                )}
+                            </span>
+                            {p.transportadora_nome && (
+                                <span className="badge neutro" style={{ fontSize: 11 }}>{p.transportadora_nome}</span>
                             )}
                         </span>
-                        {p.transportadora_nome && (
-                            <span className="badge neutro" style={{ fontSize: 11 }}>{p.transportadora_nome}</span>
-                        )}
                         <span style={{ fontSize: 12, color: 'var(--text-secondary)' }}>Pronto para conferência</span>
                     </button>
                 ))}
diff --git a/wms-coletor/src/pages/SeparacaoErp.jsx b/wms-coletor/src/pages/SeparacaoErp.jsx
index 6a03567..559ab99 100644
--- a/wms-coletor/src/pages/SeparacaoErp.jsx
+++ b/wms-coletor/src/pages/SeparacaoErp.jsx
@@ -285,15 +285,17 @@ export default function SeparacaoErp() {
                         onClick={() => abrirPedido(p.id)}
                         style={{ display: 'flex', flexDirection: 'column', alignItems: 'flex-start', gap: 2 }}
                     >
-                        <span style={{ display: 'flex', alignItems: 'baseline', gap: 8 }}>
-                            <span style={{ fontWeight: 600 }}>{p.numero_erp}</span>
-                            {formatarData(p.criado_em) && (
-                                <span style={{ fontSize: 11, color: 'var(--text-muted)' }}>{formatarData(p.criado_em)}</span>
+                        <span style={{ display: 'flex', alignItems: 'baseline', justifyContent: 'space-between', width: '100%' }}>
+                            <span style={{ display: 'flex', alignItems: 'baseline', gap: 8 }}>
+                                <span style={{ fontWeight: 600 }}>{p.numero_erp}</span>
+                                {formatarData(p.criado_em) && (
+                                    <span style={{ fontSize: 11, color: 'var(--text-muted)' }}>{formatarData(p.criado_em)}</span>
+                                )}
+                            </span>
+                            {p.transportadora_nome && (
+                                <span className="badge neutro" style={{ fontSize: 11 }}>{p.transportadora_nome}</span>
                             )}
                         </span>
-                        {p.transportadora_nome && (
-                            <span className="badge neutro" style={{ fontSize: 11 }}>{p.transportadora_nome}</span>
-                        )}
                         <span style={{ fontSize: 12, color: 'var(--text-secondary)' }}>
                             {ETAPA_LABEL[p.etapa_separacao] || p.etapa_separacao}
                         </span>
-- 
