From 56f786c060cb961378460dacde35bbbd5978a626 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 18 Sep 2026 17:28:05 +0000
Subject: [PATCH] fix: bipagem marcava serial como separado antes de checar se
 pertence ao pedido
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Usuario reportou: colaborador bipou por engano os seriais #117122,
#117132, #117135, #117138, #117148 (todos SKU 7005005) na ordem de
separacao 43701, que na verdade so tem os SKUs 2005026 e 3005041 -
nenhum dos dois é o 7005005. O sistema deveria ter dado erro e nao
registrado nada, mas a peca sumiu do estoque disponivel mesmo assim.

Causa raiz: a rota POST /:pedidoId/bipar-serial ja tinha a checagem
certa ("produto nao faz parte desta ordem de separação", 400), mas
ela rodava DEPOIS do passo que trava a unidade fisica pra nao ser
bipada 2x (UPDATE unidades_serializadas SET status='separado' WHERE
status='em_estoque'). Como esse UPDATE roda antes da checagem de
pedido, uma bipagem pro pedido errado JA marcava a peca como
'separado' antes de ser rejeitada - e a rejeicao (return 400) nunca
desfazia esse UPDATE. Resultado: a peca saia de 'em_estoque' (nao
aparece mais disponivel pra bipar em nenhum pedido), sem nenhuma
linha de historico (movimentacoes so grava no passo 7, nunca
alcancado) e sem nenhum jeito do operador desfazer sozinho.

Correcao: reordenado o codigo pra confirmar que o produto pertence ao
pedido (e ainda falta separar) ANTES de qualquer coisa que mude
estado - nunca mais reserva/trava uma peca de um produto que nem
pertence ao pedido bipado.

Corrigido direto no banco: os 5 seriais (#117122, #117132, #117135,
#117138, #117148) voltados pra status='em_estoque' - nenhum item de
itens_pedido do pedido 43701 tinha sido alterado (continuavam
pendente/0, confirmando que so a unidade fisica ficou presa) e nao
existia nenhuma linha em movimentacoes tipo 'separacao' pra essas
unidades (so recebimento e a reposicao pro picking, ambas
legitimas) - nao sobrou nada mais pra reverter.

Testado: node --check/require() do backend, sem erro; consulta real
no banco confirmando o estado anterior (separado, sem historico de
separacao) e o estado corrigido (em_estoque) apos a migration.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_011F5EkFD7qzPQU95aiex7Ei
---
 wms-api/routes/separacao-erp.js | 53 ++++++++++++++++++++++-----------
 1 file changed, 36 insertions(+), 17 deletions(-)

diff --git a/wms-api/routes/separacao-erp.js b/wms-api/routes/separacao-erp.js
index 9746f00..0cbdb6f 100644
--- a/wms-api/routes/separacao-erp.js
+++ b/wms-api/routes/separacao-erp.js
@@ -640,7 +640,42 @@ skuProduto = linhaSerial.productPacking?.product?.code;
 }
 const numeroSerieLimpo = serialCode.replace(/^#/, '');
 
-// 1.5. Bloqueia bipar a MESMA unidade fisica duas vezes. Isso e
+// 1.5. Confirma que esse produto pertence ao pedido e ainda falta
+// separar. ESSE CHECK TEM QUE VIR ANTES DE QUALQUER CLAIM/RESERVA
+// (ver aviso abaixo, no passo 1.6) - CORRECAO 18/09/2026 (pedido
+// 43701): antes, essa confirmacao rodava DEPOIS do passo que trava a
+// unidade fisica pra nao ser bipada 2x (UPDATE unidades_serializadas
+// SET status='separado'). Um colaborador bipou por engano 5 seriais
+// do SKU 7005005 (#117122, #117132, #117135, #117138, #117148) numa
+// ordem de separacao (pedido 43701) que nao tinha esse produto entre
+// os itens - essa mesma checagem abaixo ("confirma que o produto
+// pertence ao pedido") corretamente rejeitava com 400 ("nao faz parte
+// desta ordem de separação"), MAS como antes ela rodava depois
+// do UPDATE que marca a unidade como 'separado', a rejeicao acontecia
+// tarde demais - a unidade ja tinha sido "consumida" (saiu de
+// 'em_estoque'), sem nenhuma linha de historico registrada (o
+// registrarMovimentacao so acontece la no passo 7, nunca alcancado) e
+// sem nenhum jeito do operador desfazer isso sozinho: a peca some do
+// estoque disponivel, mas nao aparece vinculada a nenhum pedido.
+// Corrigido movendo essa checagem pra ANTES de qualquer coisa que
+// mude estado (nunca reserva/trava nada de uma peca que nem pertence
+// ao pedido).
+const { rows: itens } = await pool.query(
+`SELECT ip.id, ip.produto_id, ip.quantidade_x, ip.quantidade_separada
+FROM itens_pedido ip
+JOIN produtos pr ON pr.id = ip.produto_id
+WHERE ip.pedido_id = $1 AND pr.sku = $2`,
+[pedido.id, skuProduto]
+);
+const item = itens[0];
+if (!item) {
+return res.status(400).json({ erro: `Produto ${skuProduto} (do serial bipado) nao faz parte desta ordem de separação` });
+}
+if (item.quantidade_separada >= item.quantidade_x) {
+return res.status(400).json({ erro: `Item ${skuProduto} ja esta completo` });
+}
+
+// 1.6. Bloqueia bipar a MESMA unidade fisica duas vezes. Isso e
 // diferente da corrida corrigida no passo 2.5 abaixo (que impede
 // alocar ALEM da quantidade do pedido) - aqui o caso e: mesmo com o
 // item ainda tendo vaga (ex: pedido de 3 unidades, so 1 bipada ate
@@ -690,22 +725,6 @@ return res.status(409).json({ erro: `Serial ${serialCode} ja foi bipado nesta or
 }
 }
 
-// 2. Confirma que esse produto pertence ao pedido e ainda falta separar
-const { rows: itens } = await pool.query(
-`SELECT ip.id, ip.produto_id, ip.quantidade_x, ip.quantidade_separada
-FROM itens_pedido ip
-JOIN produtos pr ON pr.id = ip.produto_id
-WHERE ip.pedido_id = $1 AND pr.sku = $2`,
-[pedido.id, skuProduto]
-);
-const item = itens[0];
-if (!item) {
-return res.status(400).json({ erro: `Produto ${skuProduto} (do serial bipado) nao faz parte desta ordem de separação` });
-}
-if (item.quantidade_separada >= item.quantidade_x) {
-return res.status(400).json({ erro: `Item ${skuProduto} ja esta completo` });
-}
-
 // 2.5. Reserva atomicamente 1 unidade desse item ANTES de chamar o
 // ZenERP - fecha a corrida real que causou o pedido 43136 alocar 82
 // unidades do 1015015 tendo pedido so 81: duas bipagens quase
